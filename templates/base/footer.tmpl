{{if false}}
	{{/* to make html structure "likely" complete to prevent IDE warnings */}}
<html>
<body>
	<div>
{{end}}

		{{template "custom/body_inner_post" .}}
	</div>
	{{template "custom/body_outer_post" .}}
	{{template "base/footer_content" .}}
	<dialog class="shortcut-help" aria-labelledby="shortcut-help-title" data-global-init="onShortcutHelp" data-shortcut-keys="?" data-shortcut-description="{{ctx.Locale.Tr "shortcuts.help.show"}}" data-shortcut-section="{{ctx.Locale.Tr "shortcuts.general"}}">
		<form method="dialog" class="shortcut-help-header">
			<h2 id="shortcut-help-title">{{ctx.Locale.Tr "shortcuts.help.title"}}</h2>
			<button class="btn interact-fg" aria-label="{{ctx.Locale.Tr "shortcuts.help.close"}}">{{svg "octicon-x" 16}}</button>
		</form>
		<div class="shortcut-help-sections"></div>
		<div class="shortcut-help-footer">
			<div class="ui checkbox">
				<input id="shortcut-help-enabled" class="shortcut-help-enabled" type="checkbox" checked>
				<label for="shortcut-help-enabled">{{ctx.Locale.Tr "shortcuts.help.enable"}}</label>
			</div>
		</div>
	</dialog>
	{{ctx.ScriptImport "web_src/js/index.ts" "module"}}
	{{template "custom/footer" .}}
	<script nonce="{{ctx.CspScriptNonce}}" type="module">
	if (!window.config?.frontendInited && window.config?.runModeIsProd) alert("Frontend is not initialized, check console errors or asset files.");
	</script>
</body>
</html>
