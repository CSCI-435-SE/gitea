<div role="main" aria-label="{{.Title}}" class="page-content user notification" id="notification_div" data-sequence-number="{{.SequenceNumber}}"
	data-global-init="initNotificationBulkActions" data-view-key="{{.ViewKey}}" data-view-count="{{.ViewCount}}"
	data-bulk-url="{{QueryBuild (print AppSubUrl "/notifications/bulk") "type" $.PageType "page" $.Page.Paginater.Current "repo" $.FilterRepoID "source" $.FilterSource "group" (Iif $.GroupByRepo "repo" "")}}"
>
	<div class="ui container">
		{{template "base/alert" .}}
		{{$notificationUnreadCount := .FilteredUnreadCount}}{{/* the navbar badge stays global */}}
		{{$pageTypeIsRead := eq $.PageType "read"}}
		{{$groupParam := Iif $.GroupByRepo "repo" ""}}{{/* a view setting, kept by every link like the filters */}}
		{{$filterQuery := QueryBuild "repo" $.FilterRepoID "source" $.FilterSource "group" $groupParam}}
		{{$notificationsLink := print AppSubUrl "/notifications"}}{{/* a path prefix lets QueryBuild drop the "?" when every param is empty */}}
		{{$queryLink := QueryBuild $notificationsLink "type" $.PageType "repo" $.FilterRepoID "source" $.FilterSource "group" $groupParam}}
		<div class="flex-left-right tw-mb-[--page-spacing]">
			<div class="small-menu-items ui compact tiny menu">
				<a class="{{if not $pageTypeIsRead}}active{{end}} item" href="{{QueryBuild $notificationsLink "type" "unread" "repo" $.FilterRepoID "source" $.FilterSource "group" $groupParam}}">
					{{ctx.Locale.Tr "notification.unread"}}
					<div class="notifications-unread-count ui label {{if not $notificationUnreadCount}}tw-hidden{{end}}">{{$notificationUnreadCount}}</div>
				</a>
				<a class="{{if $pageTypeIsRead}}active{{end}} item" href="{{QueryBuild $notificationsLink "type" "read" "repo" $.FilterRepoID "source" $.FilterSource "group" $groupParam}}">
					{{ctx.Locale.Tr "notification.read"}}
				</a>
			</div>
			<div class="flex-text-block">
				<div class="list-header-filters ui secondary menu tw-m-0">
					<div class="ui dropdown jump item" data-test-id="notification-filter-repo">
						<span class="text">{{if $.FilterRepo}}{{$.FilterRepo.FullName}}{{else}}{{ctx.Locale.Tr "notification.filter_repo"}}{{end}}</span>
						{{svg "octicon-triangle-down" 14 "dropdown icon"}}
						<div class="menu">
							<div class="ui icon search input">
								<i class="icon">{{svg "octicon-search"}}</i>
								<input type="text" placeholder="{{ctx.Locale.Tr "notification.filter_repo"}}">
							</div>
							<a class="item{{if not $.FilterRepoID}} selected{{end}}" href="{{QueryBuild $queryLink "repo" NIL}}">{{ctx.Locale.Tr "notification.filter_repo_all"}}</a>
							{{range $.FilterRepos}}
								<a class="item flex-text-block{{if eq .ID $.FilterRepoID}} selected{{end}}" href="{{QueryBuild $queryLink "repo" .ID}}">
									<span class="tw-flex-1 gt-ellipsis">{{.FullName}}</span>
									{{if $.FilterRepoUnread.Contains .ID}}
										<span class="tw-inline-block tw-w-2 tw-h-2 tw-rounded-full tw-bg-blue" role="img" aria-label="{{ctx.Locale.Tr "notification.filter_repo_has_unread"}}" data-tooltip-content="{{ctx.Locale.Tr "notification.filter_repo_has_unread"}}"></span>
									{{end}}
								</a>
							{{end}}
						</div>
					</div>
					<div class="ui dropdown jump item" data-test-id="notification-filter-type">
						<span class="text">{{if $.FilterSource}}{{ctx.Locale.Tr (printf "notification.filter_type_%s" $.FilterSource)}}{{else}}{{ctx.Locale.Tr "notification.filter_type"}}{{end}}</span>
						{{svg "octicon-triangle-down" 14 "dropdown icon"}}
						<div class="menu">
							<a class="item{{if not $.FilterSource}} selected{{end}}" href="{{QueryBuild $queryLink "source" NIL}}">{{ctx.Locale.Tr "notification.filter_type_all"}}</a>
							<a class="item{{if eq $.FilterSource "issue"}} selected{{end}}" href="{{QueryBuild $queryLink "source" "issue"}}">{{ctx.Locale.Tr "notification.filter_type_issue"}}</a>
							<a class="item{{if eq $.FilterSource "pull"}} selected{{end}}" href="{{QueryBuild $queryLink "source" "pull"}}">{{ctx.Locale.Tr "notification.filter_type_pull"}}</a>
							<a class="item{{if eq $.FilterSource "commit"}} selected{{end}}" href="{{QueryBuild $queryLink "source" "commit"}}">{{ctx.Locale.Tr "notification.filter_type_commit"}}</a>
							<a class="item{{if eq $.FilterSource "repository"}} selected{{end}}" href="{{QueryBuild $queryLink "source" "repository"}}">{{ctx.Locale.Tr "notification.filter_type_repository"}}</a>
						</div>
					</div>
				</div>
				<a class="ui mini basic button{{if $.GroupByRepo}} active{{end}}" href="{{QueryBuild $queryLink "group" (Iif $.GroupByRepo "" "repo")}}"{{if $.GroupByRepo}} aria-current="true"{{end}} data-test-id="notification-group-repo">
					{{svg "octicon-rows" 14}} {{ctx.Locale.Tr "notification.group_by_repo"}}
				</a>
				{{if $.IsFiltered}}
					<a class="ui mini basic button" href="{{QueryBuild $notificationsLink "type" $.PageType "group" $groupParam}}">{{ctx.Locale.Tr "notification.clear_filters"}}</a>
				{{end}}
				{{if and (not $pageTypeIsRead) $notificationUnreadCount}}
					{{$markAllTitle := Iif $.IsFiltered (ctx.Locale.Tr "notification.mark_all_filtered_as_read") (ctx.Locale.Tr "notification.mark_all_as_read")}}
					<form action="{{AppSubUrl}}/notifications/purge{{if $filterQuery}}?{{$filterQuery}}{{end}}" method="post">
						<button class="ui mini button primary tw-mr-0" title="{{$markAllTitle}}" aria-label="{{$markAllTitle}}">
							{{svg "octicon-checklist"}}
						</button>
					</form>
				{{end}}
			</div>
		</div>
		{{if .Notifications}}
			<div class="notification-bulk-bar flex-text-block tw-mb-2">
				<input type="checkbox" autocomplete="off" class="notification-checkbox-all" aria-label="{{ctx.Locale.Tr "notification.select_page"}}" data-tooltip-content="{{ctx.Locale.Tr "notification.select_page"}}">
				<div class="notification-bulk-actions flex-text-block tw-hidden">
					<span>{{ctx.Locale.Tr "notification.selected_count" (HTMLFormat `<span class="notification-selected-count">%d</span>` 0)}}</span>
					<a class="notification-select-all-view tw-hidden" href="#">{{ctx.Locale.Tr "notification.select_all_in_view" $.ViewCount}}</a>
					<button class="ui mini basic button notification-bulk-action" data-action="mark_as_read">{{svg "octicon-check" 14}} {{ctx.Locale.Tr "notification.mark_as_read"}}</button>
					<button class="ui mini basic button notification-bulk-action" data-action="mark_as_unread">{{svg "octicon-bell" 14}} {{ctx.Locale.Tr "notification.mark_as_unread"}}</button>
					<button class="ui mini basic button notification-bulk-action" data-action="pin">{{svg "octicon-pin" 14}} {{ctx.Locale.Tr "notification.bulk_pin"}}</button>
					<button class="ui mini basic red button notification-bulk-action" data-action="delete" data-confirm="{{ctx.Locale.Tr "notification.delete_confirm"}}">{{svg "octicon-trash" 14}} {{ctx.Locale.Tr "notification.delete"}}</button>
				</div>
			</div>
		{{end}}
		<div id="notification_table"{{if $.GroupByRepo}} data-global-init="initNotificationGroups"{{end}}>
			{{if not .Notifications}}
				<div class="empty-placeholder">
					{{svg "octicon-inbox" 56 "tw-mb-4"}}
					{{if $.IsFiltered}}
						{{ctx.Locale.Tr "notification.no_filtered"}}
						<a href="{{QueryBuild $notificationsLink "type" $.PageType "group" $groupParam}}">{{ctx.Locale.Tr "notification.clear_filters"}}</a>
					{{else if $pageTypeIsRead}}
						{{ctx.Locale.Tr "notification.no_read"}}
					{{else}}
						{{ctx.Locale.Tr "notification.no_unread"}}
					{{end}}
				</div>
			{{else if $.GroupByRepo}}
				{{range $group := .NotificationGroups}}
					<div class="notification-group" data-repo-id="{{$group.Repo.ID}}">
						<div class="notification-group-header flex-text-block">
							<button type="button" class="notification-group-toggle btn interact-bg tw-p-1" aria-expanded="true" aria-controls="notification-group-rows-{{$group.Repo.ID}}" aria-label="{{ctx.Locale.Tr "notification.group_toggle" $group.Repo.FullName}}">
								{{svg "octicon-chevron-down"}}
							</button>
							<a class="silenced tw-font-semibold" href="{{$group.Repo.Link}}">{{$group.Repo.FullName}}</a>
							{{if $group.Continued}}
								<span class="tw-text-text-light-2">{{ctx.Locale.Tr "notification.group_continued"}}</span>
							{{end}}
							{{if $group.UnreadCount}}
								<span class="ui tiny label">{{ctx.Locale.Tr "notification.group_unread_count" $group.UnreadCount}}</span>
							{{end}}
						</div>
						<div class="notification-group-rows" id="notification-group-rows-{{$group.Repo.ID}}">
							{{range $one := $group.Notifications}}
								{{template "user/notification/notification_item" dict "Root" $ "Notification" $one "FilterQuery" $filterQuery}}
							{{end}}
						</div>
					</div>
				{{end}}
			{{else}}
				{{range $one := .Notifications}}
					{{template "user/notification/notification_item" dict "Root" $ "Notification" $one "FilterQuery" $filterQuery}}
				{{end}}
			{{end}}
		</div>
		{{template "base/paginate" .}}
	</div>
</div>
