{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository milestone-issue-list">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		<div class="flex-text-block tw-flex-wrap tw-mb-2">
			<h1 class="tw-flex-1 tw-m-0">{{.Milestone.Name}}</h1>
			{{if not .Repository.IsArchived}}
				<div>
					{{if or .CanWriteIssues .CanWritePulls}}
						{{if .Milestone.IsClosed}}
							<a class="ui primary basic button link-action" href data-url="{{$.RepoLink}}/milestones/{{.MilestoneID}}/open">{{ctx.Locale.Tr "repo.milestones.open"}}
							</a>
						{{else}}
							<a class="ui red basic button link-action" href data-url="{{$.RepoLink}}/milestones/{{.MilestoneID}}/close">{{ctx.Locale.Tr "repo.milestones.close"}}
							</a>
						{{end}}
						<a class="ui button" href="{{.RepoLink}}/milestones/{{.MilestoneID}}/edit">{{ctx.Locale.Tr "repo.milestones.edit"}}</a>
					{{end}}
					<a class="ui primary button" href="{{.RepoLink}}/issues/new{{if .NewIssueChooseTemplate}}/choose{{end}}?milestone={{.MilestoneID}}">{{ctx.Locale.Tr "repo.issues.new"}}</a>
				</div>
			{{end}}
		</div>
		{{if .Milestone.RenderedContent}}
		<div class="render-content markup tw-mb-4">
				{{.Milestone.RenderedContent}}
		</div>
		{{end}}
		<div class="tw-flex tw-flex-col tw-gap-2">
			<progress class="milestone-progress-big" value="{{.Milestone.Completeness}}" max="100"></progress>
			<div class="flex-text-block tw-gap-4">
				<div class="flex-text-inline">
					{{$closedDate:= DateUtils.TimeSince .Milestone.ClosedDateUnix}}
					{{if .Milestone.IsClosed}}
						{{svg "octicon-clock"}} {{ctx.Locale.Tr "repo.milestones.closed" $closedDate}}
					{{else}}

						{{if .Milestone.DeadlineString}}
							{{$dueClass := ""}}{{$dueTooltip := ""}}
							{{if .Milestone.IsOverdue}}
								{{$dueClass = "tw-text-red"}}{{$dueTooltip = ctx.Locale.Tr "repo.issues.due_date_overdue"}}
							{{else if .Milestone.IsNearDue}}
								{{$dueClass = "tw-text-warning-text"}}{{$dueTooltip = ctx.Locale.Tr "repo.issues.due_date_near"}}
							{{end}}
							<span class="due-date {{$dueClass}}" {{if $dueTooltip}}data-tooltip-content="{{$dueTooltip}}"{{end}}>
								{{svg "octicon-calendar"}}
								{{DateUtils.AbsoluteShort (.Milestone.DeadlineString|DateUtils.ParseLegacy)}}
							</span>
						{{else}}
							{{svg "octicon-calendar"}}
							{{ctx.Locale.Tr "repo.milestones.no_due_date"}}
						{{end}}
					{{end}}
				</div>
				<div>{{ctx.Locale.Tr "repo.milestones.completeness" .Milestone.Completeness}}</div>
				{{if .TotalTrackedTime}}
					<div data-tooltip-content='{{ctx.Locale.Tr "tracked_time_summary"}}'>
						{{svg "octicon-clock"}}
						{{.TotalTrackedTime | Sec2Hour}}
					</div>
				{{end}}
			</div>
			<div id="milestone-burndown-chart"
				data-locale-loading-title="{{ctx.Locale.Tr "graphs.component_loading" (ctx.Locale.Tr "repo.milestones.burndown.what")}}"
				data-locale-loading-title-failed="{{ctx.Locale.Tr "graphs.component_loading_failed" (ctx.Locale.Tr "repo.milestones.burndown.what")}}"
				data-locale-loading-info="{{ctx.Locale.Tr "graphs.component_loading_info"}}"
				data-locale-component-failed-to-load="{{ctx.Locale.Tr "graphs.component_failed_to_load"}}"
				data-locale-title="{{ctx.Locale.Tr "repo.milestones.burndown.title"}}"
				data-locale-remaining="{{ctx.Locale.Tr "repo.milestones.burndown.remaining"}}"
				data-locale-scope="{{ctx.Locale.Tr "repo.milestones.burndown.scope"}}"
				data-locale-ideal="{{ctx.Locale.Tr "repo.milestones.burndown.ideal"}}"
				data-locale-projection="{{ctx.Locale.Tr "repo.milestones.burndown.projection"}}"
				data-locale-empty="{{ctx.Locale.Tr "repo.milestones.burndown.empty"}}"
				data-locale-no-deadline="{{ctx.Locale.Tr "repo.milestones.burndown.no_deadline"}}"
				data-locale-status-done="{{ctx.Locale.Tr "repo.milestones.burndown.status_done"}}"
				data-locale-status-closed="{{ctx.Locale.Tr "repo.milestones.burndown.status_closed"}}"
				data-locale-status-not-burning="{{ctx.Locale.Tr "repo.milestones.burndown.status_not_burning"}}"
				data-locale-status-insufficient="{{ctx.Locale.Tr "repo.milestones.burndown.status_insufficient"}}"
				data-locale-projected="{{ctx.Locale.Tr "repo.milestones.burndown.projected"}}"
				data-locale-projected-on-time="{{ctx.Locale.Tr "repo.milestones.burndown.projected_on_time"}}"
				data-locale-projected-on-due-date="{{ctx.Locale.Tr "repo.milestones.burndown.projected_on_due_date"}}"
				data-locale-projected-late="{{ctx.Locale.Tr "repo.milestones.burndown.projected_late"}}"
			></div>
		</div>
		<div class="divider"></div>

		{{template "repo/issue/filters" .}}

		{{template "shared/issuelist" dict "." . "listType" "milestone"}}
	</div>
</div>
{{template "base/footer" .}}
